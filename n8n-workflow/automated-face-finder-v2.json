{
  "name": "Automated Face Finder — Telegram + Drive + FaceFinder.exe",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "limit": 1,
        "postType": "viaBot"
      },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "fileType": "image",
        "propertyName": "photo_ref"
      },
      "name": "Save ref photo",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeCommand",
        "command": "mkdir -p /tmp/telegram_refs /tmp/gdrive_copy /tmp/results /tmp/approved",
        "shell": true
      },
      "name": "Init dirs",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "command": "rclone sync gdrive:scandrive /tmp/gdrive_copy/ --fast-list",
        "shell": true
      },
      "name": "Sync Google Drive (rclone)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        950,
        300
      ]
    },
    {
      "parameters": {
        "command": "C:\\Users\\DELL\\face-finder\\dist\\FaceFinder.exe --ref /tmp/telegram_refs/ --dir /tmp/gdrive_copy/ --output /tmp/results/",
        "shell": false
      },
      "name": "Run FaceFinder .exe",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "904941272",
        "text": "Scan terminé. Résultats ci-dessous — validez chaque photo ?",
        "sendMessageAs": "bot"
      },
      "name": "Send results + ask",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-token",
          "name": "TELEGRAM_BOT_TOKEN"
        }
      },
      "position": [
        1450,
        300
      ]
    },
    {
      "parameters": {
        "waitFor": "message",
        "timeoutMs": 300000
      },
      "name": "Wait for approval (5min)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "={{ $json.approved }}",
            "type": "boolean",
            "operation": "equals",
            "rightValue": true
          }
        }
      },
      "name": "Approved?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [
        1950,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "904941272",
        "mediaType": "file",
        "file": "/tmp/approved/approved_photo.jpg",
        "caption": "Photo approuvée (FaceFinder)"
      },
      "name": "Send approved photo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-token",
          "name": "TELEGRAM_BOT_TOKEN"
        }
      },
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeCommand",
        "command": "echo 'Cleanup /tmp/telegram_refs /tmp/results /tmp/approved'",
        "shell": true
      },
      "name": "Cleanup tmp",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2450,
        300
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Save ref photo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save ref photo": {
      "main": [
        [
          {
            "node": "Init dirs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Init dirs": {
      "main": [
        [
          {
            "node": "Sync Google Drive (rclone)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync Google Drive (rclone)": {
      "main": [
        [
          {
            "node": "Run FaceFinder .exe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run FaceFinder .exe": {
      "main": [
        [
          {
            "node": "Send results + ask",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send results + ask": {
      "main": [
        [
          {
            "node": "Wait for approval (5min)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for approval (5min)": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Send approved photo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Cleanup tmp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send approved photo": {
      "main": [
        [
          {
            "node": "Cleanup tmp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "id": "faceFinderAutomated001"
}